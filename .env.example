# AIMI — voorbeeld-omgevingsvariabelen.
# Kopieer naar .env en vul in. Zet echte secrets NOOIT in git.

# --- Supabase ---
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Publieke app-URL (voor o.a. login-links in e-mails)
VITE_APP_URL=

# Publieke site-URL, gebruikt door sitemap.xml (fallback: https://aimi-development.nl)
VITE_SITE_URL=

# --- SMTP (welkomstmail / wachtwoord) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Monitoring ---
MONITORING_ADMIN_KEY=

# --- Telegram-integratie ---
# Bot-token van @BotFather (server-only, nooit naar de client).
TELEGRAM_BOT_TOKEN=
# Bot-username zonder @ (voor de t.me koppel-deeplink), bv. AIMIPortaalBot
TELEGRAM_BOT_USERNAME=
# Eigen secret die bij setWebhook wordt meegegeven en door de webhook-route
# wordt geverifieerd (X-Telegram-Bot-Api-Secret-Token). Kies een lange random string.
TELEGRAM_WEBHOOK_SECRET=
# Optioneel: overschrijf de publieke webhook-URL (default in scripts/set-telegram-webhook.ts)
# TELEGRAM_WEBHOOK_URL=https://aimi-development.nl/api/telegram/webhook
